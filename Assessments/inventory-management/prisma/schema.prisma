generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  firstName     String   @map("first_name") @db.VarChar(20)
  lastName      String   @map("last_name") @db.VarChar(20)
  email         String   @unique @db.VarChar(50)
  password      String
  role          String   @default("VENDOR") @db.VarChar(20)
  companyName   String?  @map("company_name") @db.VarChar(50)
  contactNumber String?  @map("contact_number") @db.VarChar(15)
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inventory Inventory?
  address   Address?
  products  Product[]
  orders    Order[]
}

model Inventory {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(256)
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId   String?   @unique @map("user_id)")
  user     User?     @relation(fields: [userId], references: [id])
  address  Address?
  products Product[]
}

model Address {
  id        String   @id @default(uuid())
  city      String   @db.VarChar(256)
  pinCode   String   @map("pin_code") @db.VarChar(6)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId      String?    @unique @map("user_id)")
  user        User?      @relation(fields: [userId], references: [id])
  inventoryId String?    @unique @map("inventory_id")
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])
}

model Product {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(256)
  description String
  prize       Float
  quantity    Int
  stockStatus String  @default("OUT_OF_STOCK") @map("stock_status")
  isDeleted   Boolean @default(false) @map("is_deleted")

  user        User?      @relation(fields: [userId], references: [id])
  userId      String?    @map("user_id")
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])
  inventoryId String?    @map("inventory_id")
  order       Order[]
  categories  Category[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  products Product[]
}

model Order {
  id            String  @id @default(uuid())
  quantity      Int
  totalPrice    Float   @map("total_price")
  orderStatus   String  @default("PENDING") @map("order_status")
  paymentStatus String  @default("PENDING") @map("payment_status")
  isDeleted     Boolean @default(false) @map("is_deleted")

  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @map("user_id")
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
}
